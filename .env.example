# Azure OpenAI
AZURE_OPENAI_API_KEY=replace-with-your-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=replace-with-your-api-version
AZURE_OPENAI_MODEL=replace-with-your-deployment-name

# MySQL / SQLAlchemy
DB_URI=mysql+pymysql://USERNAME:PASSWORD@HOST:3306/DATABASE

# API server (optional)
HOST=0.0.0.0
PORT=8000
